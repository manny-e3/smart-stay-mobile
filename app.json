{
  "expo": {
    "name": "SmartStay Guest Experience",
    "slug": "smartstay-guest-experience",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartstay.guestexperience"
    },
    "android": {
      "package": "com.smartstay.guestexperience",
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SmartStay to scan your check-in QR code.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store"
    ]
  }
}
